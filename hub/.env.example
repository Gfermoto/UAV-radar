# Скопируйте в .env рядом с docker-compose.yml. Файл .env в git не кладите.

# Образ. latest — текущий выпуск. Менять не нужно.
HUB_IMAGE_TAG=latest

# LAN-адрес этой машины — тот, который узлы набирают в блоке Hub. Обязателен.
HUB_CN=192.168.1.10
HUB_PORT=9443

# Ключ кабинета: https://nevod.endorphine.agency
# Тот же ключ вставьте на каждом узле (Интеграции → Cloud → Токен Cloud).
# Им Hub принимает пакеты узлов. openssl rand -hex 32 — только если кабинета ещё нет.
INGEST_TOKEN=

# 0 = HTTPS со своим сертификатом (обычная установка). 1 = открытый HTTP, только отладка.
HTTP_CLEARTEXT=0

MEL_SAVE=1
MEL_MAX_FILES=500
HUB_MEL_LAN_ONLY=0

# Сессии входа. Пусто = только память, перезапуск их стирает.
# HUB_REDIS_URL=redis://redis:6379/0
HUB_REDIS_REQUIRED=0

# LoRa-шлюз. Профиль mqtt: хост = имя сервиса.
# MESH_MQTT_HOST=mosquitto
MESH_MQTT_PORT=1883
MESH_MQTT_USER=
MESH_MQTT_PASSWORD=
HUB_MSH_ROOT=NEVOD
MQTT_PORT=1883

# Куда Hub пересылает события.
# HUB_FORWARD_TOKEN — ключ кабинета для LoRa (в кадре LoRa своего ключа нет).
# Для узлов по Wi-Fi/Ethernet оставьте пустым: они несут свой ключ сами.
# Пустой HUB_FORWARD_TOKEN не подменяется INGEST_TOKEN.
# CLOUD_INGEST_TOKEN_DEFAULT нужен, только если узлы ещё на ключе свежей прошивки
# и своего ключа кабинета на них нет. Значение в репозиторий не кладите.
HUB_FORWARD_URL=https://nevod.endorphine.agency
HUB_FORWARD_TOKEN=
CLOUD_INGEST_TOKEN_DEFAULT=
HUB_FORWARD_MEL=1
